# Copy to .env on the server (next to docker-compose.prod.yml), fill in, then: chmod 600 .env
# Generate passwords/secrets with: openssl rand -hex 32

# Image tags (latest = newest main build)
BACKEND_TAG=latest
FRONTEND_TAG=latest
SCRAPER_TAG=latest

# Public URL of the site
APP_BASE_URL=https://kazdy-nieruch.pl
# Let's Encrypt contact (certificate expiry notices)
ACME_EMAIL=

# PostgreSQL
POSTGRES_DB=property_aggregator
POSTGRES_USER=property_aggregator
POSTGRES_PASSWORD=

# RabbitMQ
RABBITMQ_USERNAME=property_aggregator
RABBITMQ_PASSWORD=

# Auth0 (API + "Regular Web Application" for the frontend)
AUTH0_DOMAIN=
AUTH0_AUDIENCE=https://api.propertyaggregator
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=

# Consents
TERMS_VERSION=
MARKETING_CONSENT_VERSION=

# Geocoding (Nominatim requires an identifying User-Agent)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=

# Scraper
SCRAPER_REQUEST_DELAY=3.0
SCRAPER_REQUEST_TIMEOUT=15
SCRAPER_FIRST_PAGE_INTERVAL=10
SCRAPER_FULL_SCRAPE_TIME=02:00
# Optional (defaults shown): random delay between requests to a portal = REQUEST_DELAY + 0..REQUEST_JITTER s,
# a long pause of LONG_PAUSE_MIN..MAX s every LONG_PAUSE_AFTER_MIN..MAX requests (AFTER_MAX=0 disables it),
# and a pause of SOURCE_PAUSE_MIN..MAX s between two sources of the same portal
# SCRAPER_REQUEST_JITTER=3.0
# SCRAPER_LONG_PAUSE_AFTER_MIN=40
# SCRAPER_LONG_PAUSE_AFTER_MAX=80
# SCRAPER_LONG_PAUSE_MIN=20
# SCRAPER_LONG_PAUSE_MAX=60
# SCRAPER_SOURCE_PAUSE_MIN=30
# SCRAPER_SOURCE_PAUSE_MAX=90
